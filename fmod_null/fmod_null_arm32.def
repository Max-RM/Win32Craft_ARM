    ?setMute@ChannelControl@FMOD@@QAA?AW4FMOD_RESULT@@_N@Z=fmod_ChannelControl_setMute
    ?setOutput@System@FMOD@@QAA?AW4FMOD_RESULT@@W4FMOD_OUTPUTTYPE@@@Z=fmod_System_setOutput
    ?set3DMinMaxDistance@Sound@FMOD@@QAA?AW4FMOD_RESULT@@MM@Z=fmod_Sound_set3DMinMaxDistance
    ?release@Sound@FMOD@@QAA?AW4FMOD_RESULT@@XZ=fmod_Sound_release
    ?createSound@System@FMOD@@QAA?AW4FMOD_RESULT@@PBDIPAUFMOD_CREATESOUNDEXINFO@@PAPAVSound@2@@Z=fmod_System_createSound
    ?stop@ChannelControl@FMOD@@QAA?AW4FMOD_RESULT@@XZ=fmod_ChannelControl_stop
    ?set3DAttributes@ChannelControl@FMOD@@QAA?AW4FMOD_RESULT@@PBUFMOD_VECTOR@@00@Z=fmod_ChannelControl_set3DAttributes
    ?getSoftwareFormat@System@FMOD@@QAA?AW4FMOD_RESULT@@PAHPAW4FMOD_SPEAKERMODE@@0@Z=fmod_System_getSoftwareFormat
