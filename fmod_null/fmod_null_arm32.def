    ?isPlaying@ChannelControl@FMOD@@QAA?AW4FMOD_RESULT@@PA_N@Z=fmod_ChannelControl_isPlaying
    ?update@System@FMOD@@QAA?AW4FMOD_RESULT@@XZ=fmod_System_update
    ?set3DListenerAttributes@System@FMOD@@QAA?AW4FMOD_RESULT@@HPBUFMOD_VECTOR@@000@Z=fmod_System_set3DListenerAttributes
    ?getDriverInfo@System@FMOD@@QAA?AW4FMOD_RESULT@@HPADHPAUFMOD_GUID@@PAHPAW4FMOD_SPEAKERMODE@@2@Z=fmod_System_getDriverInfo
