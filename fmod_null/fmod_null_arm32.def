    ?getMasterChannelGroup@System@FMOD@@QAA?AW4FMOD_RESULT@@PAPAVChannelGroup@2@@Z=fmod_System_getMasterChannelGroup
    ?addGroup@ChannelGroup@FMOD@@QAA?AW4FMOD_RESULT@@PAV12@_NPAPAVDSPConnection@2@@Z=fmod_ChannelGroup_addGroup
    ?close@System@FMOD@@QAA?AW4FMOD_RESULT@@XZ=fmod_System_close
    ?release@System@FMOD@@QAA?AW4FMOD_RESULT@@XZ=fmod_System_release
    ?mixerResume@System@FMOD@@QAA?AW4FMOD_RESULT@@XZ=fmod_System_mixerResume
