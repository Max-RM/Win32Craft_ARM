    ?setMode@Sound@FMOD@@QAA?AW4FMOD_RESULT@@I@Z=fmod_Sound_setMode
    ?setFileSystem@System@FMOD@@QAA?AW4FMOD_RESULT@@P6A?AW43@PBDPAIPAPAXPAX@ZP6A?AW43@33@ZP6A?AW43@33I13@ZP6A?AW43@3I3@ZP6A?AW43@PAUFMOD_ASYNCREADINFO@@3@Z9H@Z=fmod_System_setFileSystem
