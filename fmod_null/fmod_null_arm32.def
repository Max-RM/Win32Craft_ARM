; fmod_null_arm32.def - exports of the silent fmod_ARM.dll replacement (Minecraft 1.2.8 ARM32).
; Left side = the exact C++-mangled name the game imports (byte for byte; the loader matches by name),
; right side = the C function in fmod_null.c.  On ARM, C symbols are undecorated.
; Keep in sync with arm32/facts/imports_table.json (fmod_null_test.py checks the built DLL against it).
LIBRARY fmod_ARM.dll
EXPORTS
    ?getVersion@System@FMOD@@QAA?AW4FMOD_RESULT@@PAI@Z=fmod_System_getVersion
    ?init@System@FMOD@@QAA?AW4FMOD_RESULT@@HIPAX@Z=fmod_System_init
